{
  "name": "easy-archive",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "update-assets": "bash scripts/update-assets.sh",
    "pre-check": "cargo fmt && cargo clippy --fix --allow-dirty --allow-staged && cargo test && npm run format",
    "build": "pnpm run -r build",
    "test": "pnpm run --parallel test",
    "test:run": "pnpm run --parallel test:run",
    "format": "deno fmt --ignore=easy-archive-wasm/src-ts/wasm --indent-width=2 --no-semicolons --single-quote"
  },
  "description": "easy-archive",
  "main": "dist/index.js",
  "bin": "./bin/cli.js",
  "types": "./dist/index.d.ts",
  "author": "ahaoboy",
  "license": "MIT",
  "homepage": "https://github.com/ahaoboy/easy-archive",
  "files": [
    "dist",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahaoboy/easy-archive.git"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wasm-pack-inline": "catalog:"
  },
  "catalog": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wasm-pack-inline": "^0.1.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "vite": "^8.3.4",
    "vite-bundle-analyzer": "^1.3.9"
  },
  "workspaces": [
    "*"
  ]
}
